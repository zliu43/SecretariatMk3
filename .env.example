# Copy what you need to .env (or an untracked .env.local). Z.ai endpoints were removed (#1); don't add them back.

# Optional local provider config file; empty uses the bundled config.
SECRETARIAT_BUILTIN_PROVIDER_CONFIG_FILE=

# Intranet or private deployment addresses have no default; set them explicitly when needed.
SECRETARIAT_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
SECRETARIAT_DIST_BASE_URL=
